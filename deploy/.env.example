# Copia este archivo como .env y cambia los valores:  cp .env.example .env

# Tu IP pública con guiones + .sslip.io  (ejemplo para la IP 203.0.113.25)
DOMINIO=203-0-113-25.sslip.io

# Orígenes que pueden conectarse al juego (itch.io + tu dirección). Vacío = cualquiera.
ORIGENES_PERMITIDOS=https://html-classic.itch.zone,https://html.itch.zone,https://203-0-113-25.sslip.io

# Siempre 3 en el juego real. No lo cambies en el VPS.
JUGADORES_MINIMOS=3
